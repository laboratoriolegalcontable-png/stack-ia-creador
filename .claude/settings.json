{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/stack-ia-creador/.claude/skills/sistema-autonomo/hooks/session-start.sh",
            "timeout": 15,
            "statusMessage": "🤖 SAA v1.0 — cargando memoria y sub-agentes..."
          },
          {
            "type": "command",
            "command": "bash /home/user/stack-ia-creador/.claude/hooks/ads-start.sh",
            "timeout": 10,
            "statusMessage": "Cargando Claude Ads v2.4.0..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/blindaje/scripts/backup.sh\"",
            "timeout": 15,
            "statusMessage": "[blindaje] snapshot de memoria..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/blindaje/scripts/repair.sh\"",
            "timeout": 15,
            "statusMessage": "[blindaje] auto-reparacion..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/blindaje/scripts/verify.sh\"",
            "timeout": 15,
            "statusMessage": "[blindaje] verificacion de integridad..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$TOOL_RESULT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$FILE\" == *.js || \"$FILE\" == *.css || \"$FILE\" == *.html ]]; then cd /home/user/stack-ia-creador && npx prettier --write \"$FILE\" 2>/dev/null || true; fi",
            "timeout": 15,
            "continueOnBlock": true,
            "statusMessage": "@guardian + Prettier auto-format..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/blindaje/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Bash(git*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(echo*)",
      "Bash(npx prettier*)",
      "Bash(bash .claude/skills/sistema-autonomo/install.sh*)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(.claude/**)",
      "Write(src/**)",
      "Write(public/**)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)"
    ]
  }
}